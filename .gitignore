# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Secrets / keys — NEVER commit (Doctrine v11)
*.pem
!PUBKEY_*.pem
*.key
.env
.env.*
.secret/
.keys_DO_NOT_COMMIT.pem

# Logs, local data and temp — signed authority is NEVER stored in SQLite
*.log
*.tmp
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.db
*.db-wal
*.db-shm
.tmp-mesh-*/
.DS_Store

# Build / dist
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
